{
  "name": "datepicker-nextgen",
  "version": "1.0.0",
  "description": "A headless-first, timezone-safe, fully accessible date picker for React and vanilla JS. Single, range, multiple, week, month, quarter and year selection with presets, constraints, per-day decorations and complete theming.",
  "keywords": [
    "datepicker",
    "date-picker",
    "date-range-picker",
    "calendar",
    "react",
    "react-datepicker",
    "headless",
    "accessible",
    "a11y",
    "wai-aria",
    "typescript",
    "web-component",
    "vanilla-js",
    "booking",
    "airbnb",
    "range",
    "i18n",
    "timezone-safe",
    "date-range",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Karthik Baikati <karthik.baikati@gmail.com>",
  "contributors": [
    {
      "name": "DKGSL"
    }
  ],
  "homepage": "https://github.com/karthikbaikati/datepicker-nextgen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikbaikati/datepicker-nextgen.git"
  },
  "bugs": {
    "url": "https://github.com/karthikbaikati/datepicker-nextgen/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/react/index.cjs",
  "module": "./dist/react/index.js",
  "types": "./dist/react/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "require": "./dist/vanilla/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "dev:lib": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "size": "node scripts/report-size.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
